from scipy import stats
spending = [1800, 2200, 1900, 2100, 2300, 1700, 2000, 2400]
claimed_mean = 2000
test1 = stats.ttest_1samp(spending,popmean= claimed_mean)
print("One sample t test:",test1.statistic)
print("P value of test1:",test1.pvalue)
if  test1.pvalue < 0.05:
    print("test1 null hypothesis rejected")
else:
    print("test1 null hypothesis not rejected")

